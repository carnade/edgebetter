# ---- Database ----
POSTGRES_USER=edgebetter
POSTGRES_PASSWORD=edgebetter
POSTGRES_DB=edgebetter
DATABASE_URL=postgresql+psycopg://edgebetter:edgebetter@db:5432/edgebetter

# ---- The Odds API ----
# Free tier = 500 credits/month. Get a key at https://the-odds-api.com
# Leave blank to run without odds: stats still work, edges show "no odds".
THE_ODDS_API_KEY=

# Cost per /odds call = (number of markets) x (number of regions).
ODDS_REGIONS=us
ODDS_MARKETS_MLB=h2h,totals
ODDS_MARKETS_NBA=h2h,totals,spreads
ODDS_POLLS_PER_DAY=1
# Refuse to poll once remaining credits drop below this floor.
ODDS_CREDIT_RESERVE=50
# Skip the call entirely when no game starts within this many hours.
ODDS_LOOKAHEAD_HOURS=24
ODDS_FORMAT=american

# ---- NBA advanced-stat enrichment (stats.nba.com) ----
# Bot-gated and throttles hard. Optional upgrade only; ESPN is the backbone.
# The app must be fully correct with this off. Keep it false until proven.
ENABLE_NBA_STATS_ENRICH=false
NBA_STATS_MAX_AGE_DAYS=7

# ---- App ----
LOG_LEVEL=INFO
TZ=UTC

# ---- Per-event markets (first 5 innings, team totals, player props) ----
# Only available on /events/{id}/odds, which bills markets x regions PER GAME.
# The allocator funds game-level odds first, then props from what is left.
# The three first-five/strikeout markets were dropped: all failed their
# walk-forward gate (see markets.UNVALIDATED_MODELS) and were being paid for daily.
PROPS_MARKETS=team_totals
PROPS_MAX_GAMES_PER_DAY=4

# ---- NFL player props ----
# Cost is markets x games, polled once a week. Five markets over a 16-game slate is
# 80 credits/week; removing one saves 16. All five ship enabled.
NFL_PROP_MARKETS=player_reception_yds,player_rush_yds,player_pass_yds,player_receptions,player_rush_attempts
PROPS_DRY_RUN=false

# ---- Ports and bind addresses ----
# Defaults match the local MacBook setup, so `docker compose up` needs none of these set.
# Change them here when moving to another host rather than editing docker-compose.yml.
#
# The *_BIND values decide who can reach each service. 127.0.0.1 means this machine only;
# 0.0.0.0 means anything on the network. Only the web UI needs to be reachable from other
# devices -- the api and worker talk to the database over the internal compose network, and
# in production nginx proxies /api, so neither needs to be exposed.
DB_BIND=127.0.0.1
DB_PORT=5433
API_BIND=127.0.0.1
API_PORT=8001
WEB_BIND=0.0.0.0
WEB_PORT=5174

# ---- Remote database (development only) ----
# Where the live stack runs, so ./scripts/pull_remote.sh can copy its database down here
# for development. Leave blank on the machine that IS the live stack.
#
# Data flows one way, live host to laptop. Never point DATABASE_URL at the live database:
# backend/entrypoint.sh runs `alembic upgrade head` on every boot, so starting a dev stack
# against it while on a branch with a new migration would rewrite the production schema
# before you ran anything.
REMOTE_HOST=
REMOTE_DIR=/share/edgebetter
